<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('TheoriaCast.Music'))">
    <Version>0.1.0</Version>
    <Authors>Egumaru</Authors>
    <Product>TheoriaCast.Music</Product>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/egumaru/TheoriaCast</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TheoriaCast.Music.Api'">
    <Version>0.2.5</Version>
  </PropertyGroup>
</Project>
